{
  "manifest_version": 3,
  "name": "Shuja Downloader Pro",
  "version": "1.0.0",
  "description": "Send links and optionally capture browser downloads with your local Shuja Downloader Pro service.",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Send current tab to Shuja Downloader Pro"
  },
  "options_page": "options.html",
  "key": ""
}
